ifneq ($(USES_DEVICE_SAMSUNG_EXYNOS7870),true)
USES_DEVICE_SAMSUNG_EXYNOS7870 := true
COMMON_PATH := device/samsung/exynos7870

include device/samsung/exynos7870/exynos7870/BoardConfig.mk

# A/B
AB_OTA_UPDATER := false

# OTA
TARGET_SKIP_OTA_PACKAGE := true
TARGET_OTA_ASSERT_DEVICE := exynos7870

# Partitions
BOARD_KERNEL_PAGESIZE := 2048
BOARD_BOOTIMAGE_PARTITION_SIZE     := 33554432
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 39845888
BOARD_SYSTEMIMAGE_PARTITION_SIZE   := 3072000000
BOARD_USERDATAIMAGE_PARTITION_SIZE := 10737418240
BOARD_CACHEIMAGE_PARTITION_SIZE    := 209715200
BOARD_FLASH_BLOCK_SIZE := 4096

# Recovery
TARGET_RECOVERY_FSTAB := device/samsung/exynos7870/init/fstab.samsungexynos7870
BOARD_HAS_DOWNLOAD_MODE := true
BOARD_RECOVERY_SWIPE := true

TARGET_BOARD_PLATFORM := exynos7870
